{
  "schemaVersion": "2.0",
  "description": "Executable smoke evals for liquid-glass-design. Run with scripts/run-evals.mjs.",
  "trigger_cases": [
    {
      "id": "trigger-glassmorphism-card",
      "query": "Build a glassmorphism card with premium Liquid Glass refraction.",
      "expected": true,
      "query_match_all": [
        ["liquid glass", "glassmorphism", "refraction"],
        ["card", "ui", "interface", "control"]
      ],
      "description_match_all": [
        ["Liquid Glass", "glassmorphism", "refraction", "backdrop-filter"]
      ],
      "exclude_any": []
    },
    {
      "id": "trigger-chinese-frosted-nav",
      "query": "帮我做一个高级的毛玻璃导航栏，要有液态玻璃质感。",
      "expected": true,
      "query_match_all": [
        ["毛玻璃", "液态玻璃"],
        ["导航栏", "导航", "界面", "UI"]
      ],
      "description_match_all": [
        ["Liquid Glass", "glassmorphism", "translucent"]
      ],
      "exclude_any": []
    },
    {
      "id": "trigger-svg-displacement",
      "query": "Use SVG feDisplacementMap and chromatic aberration for a glass toolbar.",
      "expected": true,
      "query_match_all": [
        ["feDisplacementMap", "chromatic"],
        ["toolbar", "control", "UI"]
      ],
      "description_match_all": [
        ["feDisplacementMap", "chromatic aberration", "refraction"]
      ],
      "exclude_any": []
    },
    {
      "id": "no-trigger-water-physics",
      "query": "Make a realistic glass water simulation with fluid physics.",
      "expected": false,
      "query_match_all": [
        ["glass"],
        ["simulation", "physics"]
      ],
      "description_match_all": [
        ["glass", "Liquid Glass"]
      ],
      "exclude_any": ["water simulation", "fluid physics"]
    },
    {
      "id": "no-trigger-wine-glass-logo",
      "query": "Design a wine glass logo for a restaurant.",
      "expected": false,
      "query_match_all": [
        ["glass"],
        ["logo"]
      ],
      "description_match_all": [
        ["glass", "Liquid Glass"]
      ],
      "exclude_any": ["wine glass logo", "logo for a restaurant"]
    },
    {
      "id": "no-trigger-window-repair",
      "query": "Help me replace a broken glass window at home.",
      "expected": false,
      "query_match_all": [
        ["glass"],
        ["window"]
      ],
      "description_match_all": [
        ["glass", "Liquid Glass"]
      ],
      "exclude_any": ["window at home", "broken glass"]
    }
  ],
  "static_assertions": [
    {
      "id": "implementation-has-displacement-api",
      "paths": ["assets/templates", "scripts/generate-displacement-map.mjs"],
      "must_include_any": ["feDisplacementMap", "createLiquidGlassDisplacementMap", "generate-displacement-map"]
    },
    {
      "id": "implementation-does-not-use-background-fixed",
      "paths": ["assets/templates"],
      "must_not_include": ["background-attachment\\s*:\\s*fixed"]
    },
    {
      "id": "implementation-does-not-use-feoffset-channel-shift",
      "paths": ["assets/templates"],
      "must_not_include": ["<feOffset\\b", "feOffset\\("]
    },
    {
      "id": "qa-script-supports-data-role-and-baseline",
      "paths": ["scripts/check-visual-geometry.mjs"],
      "must_include_all": ["data-lg-role", "baseline-dir", "pixel-threshold", "roi-baseline-only"]
    },
    {
      "id": "skill-requires-measurable-layout-roles",
      "paths": ["SKILL.md"],
      "must_include_all": ["data-lg-role=\"stage\"", "data-lg-role=\"focus\"", "data-lg-role=\"dock\"", "data-lg-role=\"rail\"", "check-visual-geometry\\.mjs"]
    },
    {
      "id": "qa-script-supports-fallback-contrast-and-core",
      "paths": ["scripts/check-visual-geometry.mjs"],
      "must_include_all": ["playwright-core", "force-fallback", "expect-svg-filter", "contrast", "min-contrast", "adaptive-synced", "adaptive-mode-diversity", "adaptive-luminance-range"]
    },
    {
      "id": "templates-use-generated-core-copies",
      "paths": ["../../package.json", "scripts/sync-template-core.mjs", "assets/templates/vanilla-liquid-glass", "assets/templates/react-liquid-glass/src", "assets/templates/web-component-liquid-glass"],
      "must_include_all": ["sync:templates", "GENERATED FROM skills/liquid-glass-design/assets/core/liquid-glass-core\\.js", "\\./liquid-glass-core\\.js", "createLiquidGlassDisplacementPixels", "supportsLiquidGlassSvgFilter"]
    },
    {
      "id": "templates-expose-adaptive-glass",
      "paths": ["assets/core/liquid-glass-core.js", "assets/templates/vanilla-liquid-glass", "assets/templates/react-liquid-glass", "assets/templates/web-component-liquid-glass"],
      "must_include_all": ["createAdaptiveLiquidGlassController", "syncAdaptiveLiquidGlass", "data-lg-adaptive", "adaptive\\?", "adaptive-inset", "throttleMs", "--lg-adaptive-tint"]
    },
    {
      "id": "core-uses-engine-fallback-for-svg-backdrop-filters",
      "paths": ["assets/core/liquid-glass-core.js"],
      "must_include_all": ["CSS\\?\\.supports", "__LG_FORCE_FALLBACK__", "isKnownBackdropSvgFilterUnsupported", "Firefox", "Safari"]
    },
    {
      "id": "web-component-template-is-portable",
      "paths": ["assets/templates/web-component-liquid-glass"],
      "must_include_all": ["customElements\\.define", "<liquid-glass", "feDisplacementMap", "createLiquidGlassDisplacementMap"]
    },
    {
      "id": "package-script-excludes-heavy-directories",
      "paths": ["scripts/package-skill.mjs"],
      "must_include_all": ["node_modules", "dist", "dry-run", "lean", "evals/baselines"]
    },
    {
      "id": "distribution-has-npm-packages-and-plugin-metadata",
      "paths": ["../../packages", "../../.codex-plugin/plugin.json", "../../.claude-plugin/plugin.json", "../../.claude-plugin/marketplace.json", "../../README.md", "../../package.json", "../../scripts/publish-npm-packages.mjs", "../../scripts/validate-plugin-manifests.mjs", "../../.github/workflows/release.yml"],
      "must_include_all": ["liquid-glass-core", "@liquid-glass-design/react", "\\.codex-plugin", "\\.claude-plugin", "marketplace\\.json", "npm pack --dry-run", "npm:publish", "--provenance", "NPM_PUBLISH_ENABLED"]
    },
    {
      "id": "plugin-manifests-avoid-symlink-and-parent-escape",
      "paths": ["../../package.json", "../../.codex-plugin/plugin.json", "../../.claude-plugin/plugin.json", "../../.claude-plugin/marketplace.json", "../../scripts/validate-claude-plugin-install.mjs", "../../scripts/validate-plugin-manifests.mjs"],
      "must_include_all": ["\\.\\/skills\\/", "assertNoSymlink", "must not escape the plugin root", "manifest\\.json is intentionally not supported", "marketplace", "plugin list", "install-smoke"],
      "must_not_include": ["\\.\\.\\/liquid-glass-design"]
    },
    {
      "id": "ci-serves-template-directories-and-publishes-combined-pages",
      "paths": ["../../package.json", "../../.github/workflows/ci.yml", "../../scripts/prepare-pages.mjs", "../../README.md"],
      "must_include_all": ["assets/templates/vanilla-liquid-glass", "http://127\\.0\\.0\\.1:4173/", "preview-latest\\.png", "peaceiris/actions-gh-pages", "pages:prepare", "publish_dir:\\s*artifacts/pages", "demo/vanilla", "demo/react", "demo/web-component"]
    },
    {
      "id": "behavior-eval-scaffold-is-runnable",
      "paths": ["scripts/run-behavior-eval.mjs", "../../.github/workflows/nightly-behavior-eval.yml"],
      "must_include_all": ["RUN_BEHAVIOR_EVAL", "claude", "installSkillForClaude", "\\.claude\\/skills", "compare-without-skill", "check-visual-geometry", "Nightly Behavior Eval"]
    }
  ]
}
