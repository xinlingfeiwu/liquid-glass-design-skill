{
  "schemaVersion": "2.0",
  "description": "Executable smoke evals for liquid-glass-design. Run with scripts/run-evals.mjs.",
  "trigger_cases": [
    {
      "id": "trigger-glassmorphism-card",
      "query": "Build a glassmorphism card with premium Liquid Glass refraction.",
      "expected": true,
      "match_any": ["liquid glass", "glassmorphism", "refraction", "backdrop-filter"],
      "exclude_any": []
    },
    {
      "id": "trigger-chinese-frosted-nav",
      "query": "帮我做一个高级的毛玻璃导航栏，要有液态玻璃质感。",
      "expected": true,
      "match_any": ["毛玻璃", "液态玻璃", "glass", "translucent"],
      "exclude_any": []
    },
    {
      "id": "trigger-svg-displacement",
      "query": "Use SVG feDisplacementMap and chromatic aberration for a glass toolbar.",
      "expected": true,
      "match_any": ["feDisplacementMap", "chromatic", "glass toolbar"],
      "exclude_any": []
    },
    {
      "id": "no-trigger-water-physics",
      "query": "Make a realistic glass water simulation with fluid physics.",
      "expected": false,
      "match_any": ["glass"],
      "exclude_any": ["water simulation", "fluid physics"]
    },
    {
      "id": "no-trigger-window-repair",
      "query": "Help me replace a broken glass window at home.",
      "expected": false,
      "match_any": ["glass"],
      "exclude_any": ["window at home", "broken glass"]
    }
  ],
  "static_assertions": [
    {
      "id": "implementation-has-displacement-api",
      "paths": ["assets/templates", "scripts/generate-displacement-map.mjs"],
      "must_include_any": ["feDisplacementMap", "createLiquidGlassDisplacementMap", "generate-displacement-map"]
    },
    {
      "id": "implementation-does-not-use-background-fixed",
      "paths": ["assets/templates"],
      "must_not_include": ["background-attachment\\s*:\\s*fixed"]
    },
    {
      "id": "implementation-does-not-use-feoffset-channel-shift",
      "paths": ["assets/templates"],
      "must_not_include": ["<feOffset\\b", "feOffset\\("]
    },
    {
      "id": "qa-script-supports-data-role-and-baseline",
      "paths": ["scripts/check-visual-geometry.mjs"],
      "must_include_any": ["data-lg-role", "baseline-dir", "pixel-threshold"]
    },
    {
      "id": "package-script-excludes-heavy-directories",
      "paths": ["scripts/package-skill.mjs"],
      "must_include_any": ["node_modules", "dist", "dry-run"]
    }
  ]
}
