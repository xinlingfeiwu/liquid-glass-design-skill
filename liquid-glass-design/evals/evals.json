{
  "schemaVersion": "2.0",
  "description": "Executable smoke evals for liquid-glass-design. Run with scripts/run-evals.mjs.",
  "trigger_cases": [
    {
      "id": "trigger-glassmorphism-card",
      "query": "Build a glassmorphism card with premium Liquid Glass refraction.",
      "expected": true,
      "query_match_all": [
        ["liquid glass", "glassmorphism", "refraction"],
        ["card", "ui", "interface", "control"]
      ],
      "description_match_all": [
        ["Liquid Glass", "glassmorphism", "refraction", "backdrop-filter"]
      ],
      "exclude_any": []
    },
    {
      "id": "trigger-chinese-frosted-nav",
      "query": "帮我做一个高级的毛玻璃导航栏，要有液态玻璃质感。",
      "expected": true,
      "query_match_all": [
        ["毛玻璃", "液态玻璃"],
        ["导航栏", "导航", "界面", "UI"]
      ],
      "description_match_all": [
        ["Liquid Glass", "glassmorphism", "translucent"]
      ],
      "exclude_any": []
    },
    {
      "id": "trigger-svg-displacement",
      "query": "Use SVG feDisplacementMap and chromatic aberration for a glass toolbar.",
      "expected": true,
      "query_match_all": [
        ["feDisplacementMap", "chromatic"],
        ["toolbar", "control", "UI"]
      ],
      "description_match_all": [
        ["feDisplacementMap", "chromatic aberration", "refraction"]
      ],
      "exclude_any": []
    },
    {
      "id": "no-trigger-water-physics",
      "query": "Make a realistic glass water simulation with fluid physics.",
      "expected": false,
      "query_match_all": [
        ["glass"],
        ["simulation", "physics"]
      ],
      "description_match_all": [
        ["glass", "Liquid Glass"]
      ],
      "exclude_any": ["water simulation", "fluid physics"]
    },
    {
      "id": "no-trigger-wine-glass-logo",
      "query": "Design a wine glass logo for a restaurant.",
      "expected": false,
      "query_match_all": [
        ["glass"],
        ["logo"]
      ],
      "description_match_all": [
        ["glass", "Liquid Glass"]
      ],
      "exclude_any": ["wine glass logo", "logo for a restaurant"]
    },
    {
      "id": "no-trigger-window-repair",
      "query": "Help me replace a broken glass window at home.",
      "expected": false,
      "query_match_all": [
        ["glass"],
        ["window"]
      ],
      "description_match_all": [
        ["glass", "Liquid Glass"]
      ],
      "exclude_any": ["window at home", "broken glass"]
    }
  ],
  "static_assertions": [
    {
      "id": "implementation-has-displacement-api",
      "paths": ["assets/templates", "scripts/generate-displacement-map.mjs"],
      "must_include_any": ["feDisplacementMap", "createLiquidGlassDisplacementMap", "generate-displacement-map"]
    },
    {
      "id": "implementation-does-not-use-background-fixed",
      "paths": ["assets/templates"],
      "must_not_include": ["background-attachment\\s*:\\s*fixed"]
    },
    {
      "id": "implementation-does-not-use-feoffset-channel-shift",
      "paths": ["assets/templates"],
      "must_not_include": ["<feOffset\\b", "feOffset\\("]
    },
    {
      "id": "qa-script-supports-data-role-and-baseline",
      "paths": ["scripts/check-visual-geometry.mjs"],
      "must_include_all": ["data-lg-role", "baseline-dir", "pixel-threshold"]
    },
    {
      "id": "qa-script-supports-fallback-contrast-and-core",
      "paths": ["scripts/check-visual-geometry.mjs"],
      "must_include_all": ["playwright-core", "force-fallback", "expect-svg-filter", "contrast", "min-contrast"]
    },
    {
      "id": "templates-use-shared-core",
      "paths": ["assets/templates/vanilla-liquid-glass/liquid-glass.js", "assets/templates/react-liquid-glass/src/displacementMap.js", "assets/templates/web-component-liquid-glass/liquid-glass-element.js"],
      "must_include_all": ["core/liquid-glass-core\\.js", "createLiquidGlassDisplacementPixels", "supportsLiquidGlassSvgFilter"],
      "must_not_include": ["navigator\\.userAgent", "Firefox", "Safari"]
    },
    {
      "id": "core-uses-engine-fallback-for-svg-backdrop-filters",
      "paths": ["assets/core/liquid-glass-core.js"],
      "must_include_all": ["CSS\\?\\.supports", "__LG_FORCE_FALLBACK__", "isKnownBackdropSvgFilterUnsupported", "Firefox", "Safari"]
    },
    {
      "id": "web-component-template-is-portable",
      "paths": ["assets/templates/web-component-liquid-glass"],
      "must_include_all": ["customElements\\.define", "<liquid-glass", "feDisplacementMap", "createLiquidGlassDisplacementMap"]
    },
    {
      "id": "package-script-excludes-heavy-directories",
      "paths": ["scripts/package-skill.mjs"],
      "must_include_all": ["node_modules", "dist", "dry-run", "lean", "evals/baselines"]
    }
  ]
}
