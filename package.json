{
  "name": "liquid-glass-design-skill",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "validate": "python3 quick_validate.py skills/liquid-glass-design",
    "sync:templates": "node skills/liquid-glass-design/scripts/sync-template-core.mjs",
    "sync:templates:check": "node skills/liquid-glass-design/scripts/sync-template-core.mjs --check",
    "preview:update": "node skills/liquid-glass-design/scripts/update-readme-preview.mjs",
    "behavior:eval": "node skills/liquid-glass-design/scripts/run-behavior-eval.mjs",
    "npm:pack": "npm pack --dry-run ./packages/liquid-glass-core && npm pack --dry-run ./packages/react-liquid-glass",
    "plugin:validate": "node scripts/validate-plugin-manifests.mjs",
    "check": "node --check scripts/validate-plugin-manifests.mjs && node --check skills/liquid-glass-design/assets/core/liquid-glass-core.js && node --check skills/liquid-glass-design/scripts/generate-displacement-map.mjs && node --check skills/liquid-glass-design/scripts/check-visual-geometry.mjs && node --check skills/liquid-glass-design/scripts/package-skill.mjs && node --check skills/liquid-glass-design/scripts/run-evals.mjs && node --check skills/liquid-glass-design/scripts/run-behavior-eval.mjs && node --check skills/liquid-glass-design/scripts/sync-template-core.mjs && node --check skills/liquid-glass-design/scripts/test-displacement-map.mjs && node --check skills/liquid-glass-design/scripts/update-readme-preview.mjs && node --check skills/liquid-glass-design/assets/templates/vanilla-liquid-glass/liquid-glass.js && node --check skills/liquid-glass-design/assets/templates/react-liquid-glass/src/displacementMap.js && node --check skills/liquid-glass-design/assets/templates/web-component-liquid-glass/liquid-glass-element.js && npm run sync:templates:check",
    "test:maps": "node skills/liquid-glass-design/scripts/test-displacement-map.mjs",
    "eval": "node skills/liquid-glass-design/scripts/run-evals.mjs",
    "package:dry": "node skills/liquid-glass-design/scripts/package-skill.mjs --dry-run && node skills/liquid-glass-design/scripts/package-skill.mjs --dry-run --lean",
    "package:skill": "node skills/liquid-glass-design/scripts/package-skill.mjs && node skills/liquid-glass-design/scripts/package-skill.mjs --lean",
    "test": "npm run validate && npm run check && npm run test:maps && npm run eval && npm run package:dry && npm run npm:pack && npm run plugin:validate",
    "dev:vanilla": "python3 -m http.server 4173 --directory skills/liquid-glass-design/assets/templates/vanilla-liquid-glass",
    "dev:web-component": "python3 -m http.server 4174 --directory skills/liquid-glass-design/assets/templates/web-component-liquid-glass",
    "qa:vanilla": "node skills/liquid-glass-design/scripts/check-visual-geometry.mjs --url http://127.0.0.1:4173/ --browser chromium --expect-svg-filter enabled --baseline-dir skills/liquid-glass-design/evals/baselines --full-page --pixel-channel-threshold 24 --roi-roles dock,focus --roi-baseline-only --roi-pixel-threshold 0.08 --reduced-motion --adaptive --contrast --min-contrast 4.5",
    "qa:vanilla:update-baseline": "node skills/liquid-glass-design/scripts/check-visual-geometry.mjs --url http://127.0.0.1:4173/ --browser chromium --expect-svg-filter enabled --baseline-dir skills/liquid-glass-design/evals/baselines --update-baseline --full-page --roi-roles dock,focus --roi-baseline-only --reduced-motion --adaptive --contrast --min-contrast 4.5",
    "qa:vanilla:fallback": "node skills/liquid-glass-design/scripts/check-visual-geometry.mjs --url http://127.0.0.1:4173/ --browser webkit --force-fallback --expect-svg-filter disabled --viewport 1440x900 --adaptive --contrast --min-contrast 4.5",
    "qa:vanilla:webkit-detect": "node skills/liquid-glass-design/scripts/check-visual-geometry.mjs --url http://127.0.0.1:4173/ --browser webkit --expect-svg-filter disabled --viewport 1440x900 --adaptive --contrast --min-contrast 4.5",
    "qa:vanilla:reduced-motion": "node skills/liquid-glass-design/scripts/check-visual-geometry.mjs --url http://127.0.0.1:4173/ --browser chromium --expect-svg-filter enabled --viewport 1440x900 --reduced-motion --adaptive --contrast --min-contrast 4.5"
  }
}
